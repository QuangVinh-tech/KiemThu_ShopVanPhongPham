@model ShopVanPhongPham.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex align-items-center mb-4">
    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
       class="btn btn-outline-secondary me-3">← Quay lại</a>
    <h2 class="fw-bold mb-0">Thêm danh mục</h2>
</div>

<div class="card shadow-sm" style="max-width:500px">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Tên danh mục <span class="text-danger">*</span>
                </label>
                <input asp-for="Name" class="form-control" placeholder="VD: Bút viết" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
                Thêm danh mục
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}