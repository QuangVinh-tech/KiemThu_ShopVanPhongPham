@model ShopVanPhongPham.Models.News
@{
    ViewData["Title"] = "Xóa tin tức";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="d-flex align-items-center mb-4">
    <a asp-area="Admin" asp-controller="News" asp-action="Index"
       class="btn btn-outline-secondary me-3">← Quay lại</a>
    <h2 class="fw-bold mb-0">Xóa tin tức</h2>
</div>

<div class="card shadow-sm border-danger" style="max-width:600px">
    <div class="card-body">
        <p>Bạn có chắc muốn xóa bài viết <strong>"@Model.Title"</strong> không?</p>
        <form asp-area="Admin" asp-controller="News" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold">
                Xác nhận xóa
            </button>
        </form>
    </div>
</div>