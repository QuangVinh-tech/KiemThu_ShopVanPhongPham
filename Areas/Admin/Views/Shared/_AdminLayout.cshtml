@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject ShopVanPhongPham.Data.AppDbContext DbContext
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

    var pendingNotifCount = DbContext.Orders.Count(o => o.Status == null || o.Status == "Chờ xử lý");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | VPP Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex admin-wrapper">
        <!-- Sidebar -->
        <div class="admin-sidebar d-flex flex-column" id="adminSidebar">
            <div class="sidebar-brand text-center">
                <div class="sidebar-logo mx-auto mb-2">
                    <img src="~/assets/images/logo.jpg" alt="VPP Shop Logo" />
                </div>
                <h5 class="fw-bold mb-0">VPP Shop</h5>
                <small>Admin Panel</small>
            </div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Admin") ? "active" : "")"
                       asp-area="Admin" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex justify-content-between align-items-center @(IsActive("Product") && currentAction != "Stock" ? "active" : "")"
                       asp-area="Admin" asp-controller="Product" asp-action="Index">
                        <span><i class="bi bi-box me-2"></i>Sản phẩm</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Product") && currentAction == "Stock" ? "active" : "")"
                       asp-area="Admin" asp-controller="Product" asp-action="Stock">
                        <i class="bi bi-box-seam me-2"></i>Tồn kho
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Category") ? "active" : "")"
                       asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags me-2"></i>Danh mục
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("News") ? "active" : "")"
                       asp-area="Admin" asp-controller="News" asp-action="Index">
                        <i class="bi bi-newspaper me-2"></i>Tin tức
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Order") ? "active" : "")"
                       asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt me-2"></i>Đơn hàng
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(IsActive("Promotion") ? "active" : "")"
                       asp-area="Admin" asp-controller="Promotion" asp-action="Index">
                        <i class="bi bi-tag me-2"></i>Khuyến mãi
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Contact") ? "active" : "")"
                       asp-area="Admin" asp-controller="Contact" asp-action="Index">
                        <i class="bi bi-envelope me-2"></i>Phản hồi
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(IsActive("User") ? "active" : "")"
                       asp-area="Admin" asp-controller="User" asp-action="Index">
                        <i class="bi bi-people me-2"></i>Người dùng
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(IsActive("AuditLog") ? "active" : "")"
                       asp-area="Admin" asp-controller="AuditLog" asp-action="Index">
                        <i class="bi bi-clock-history me-2"></i>Nhật ký hệ thống
                    </a>
                </li>
                <hr />
                <li class="nav-item">
                    <a class="nav-link text-back" asp-controller="Home" asp-action="Index" asp-area="">
                        <i class="bi bi-arrow-left-circle me-2"></i>Về trang chủ
                    </a>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="d-flex flex-column flex-grow-1" style="min-width:0">
            <div class="admin-topbar d-flex align-items-center">
                <button type="button" class="topbar-toggle" id="sidebarToggle" aria-label="Ẩn/hiện menu">
                    <i class="bi bi-list"></i>
                </button>
                <h5 class="mb-0 fw-bold topbar-brand">VPP Shop - Admin</h5>

                <form class="admin-search" role="search" onsubmit="return false;">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Tìm kiếm đơn hàng, sản phẩm, khách hàng..." />
                </form>

                <div class="d-flex align-items-center gap-3 flex-shrink-0">
                    <a class="topbar-icon-btn" title="Thông báo"
                       asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Chờ xử lý">
                        <i class="bi bi-bell"></i>
                        @if (pendingNotifCount > 0)
                        {
                            <span class="topbar-badge">@pendingNotifCount</span>
                        }
                    </a>

                    <div class="dropdown">
                        <a class="topbar-profile dropdown-toggle" href="#" role="button"
                           id="adminProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="profile-avatar"><i class="bi bi-person"></i></span>
                            <span class="profile-info">
                                <span class="profile-name">@(User.Identity?.Name ?? "Admin")</span>
                                <span class="profile-role">Quản trị viên</span>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminProfileDropdown">
                            <li>
                                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <i class="bi bi-gear me-2"></i>Tài khoản
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout"
                                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="admin-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('adminSidebar')?.classList.toggle('collapsed');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>