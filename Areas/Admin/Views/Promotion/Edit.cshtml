@model ShopVanPhongPham.Models.Promotion
@{
    ViewData["Title"] = "Sửa khuyến mãi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a asp-area="Admin" asp-controller="Promotion" asp-action="Index" class="btn btn-outline-secondary me-3"> Quay lại</a>
    <h2 class="fw-bold mb-0">Sửa khuyến mãi</h2>
</div>

@if (ViewBag.DebugErrors != null)
{
    <div class="alert alert-danger"><strong>Lỗi:</strong> @ViewBag.DebugErrors</div>
}

<div class="card shadow-sm" style="max-width:640px">
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Promotion" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Tiêu đề <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="VD: Sale hè rực rỡ" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mã giảm giá <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control" placeholder="VD: SALE10" style="text-transform:uppercase" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">% giảm giá <span class="text-danger">*</span></label>
                    <input asp-for="DiscountPercent" type="number" min="1" max="100" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Áp dụng cho sản phẩm</label>
                <select asp-for="ProductId" class="form-select">
                    <option value="">-- Toàn bộ giỏ hàng --</option>
                    @foreach (var prod in (List<ShopVanPhongPham.Models.Product>)ViewBag.Products)
                    {
                        <option value="@prod.Id">@prod.Name</option>
                    }
                </select>
                <div class="form-text">Không chọn = mã áp dụng cho toàn bộ đơn hàng.</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngày bắt đầu <span class="text-danger">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngày kết thúc <span class="text-danger">*</span></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label class="form-check-label fw-semibold">Kích hoạt ngay</label>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Ảnh <span class="text-muted fw-normal small">(không bắt buộc)</span></label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" onchange="previewImage(this)" />
                <img id="preview" src="#" alt="" class="mt-2 rounded d-none" style="max-height:150px;object-fit:cover" />
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">Thêm khuyến mãi</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            const img = document.getElementById('preview');
            if (input.files && input.files[0]) {
                img.src = URL.createObjectURL(input.files[0]);
                img.classList.remove('d-none');
            }
        }
    </script>
}