@using ShopVanPhongPham.Models
@model List<AuditLog>
@{
    ViewData["Title"] = "Nhật ký hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>Nhật ký hệ thống (Audit log)</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Thời gian</th>
                    <th>Đơn hàng</th>
                    <th>Hành động</th>
                    <th>Thực hiện bởi</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chưa có hoạt động nào được ghi lại.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@log.PerformedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-controller="Order" asp-action="Detail" asp-route-id="@log.OrderId">
                                    #@log.OrderId
                                </a>
                            </td>
                            <td>@log.Action</td>
                            <td>@log.PerformedBy</td>
                            <td class="text-muted small">@log.Note</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
