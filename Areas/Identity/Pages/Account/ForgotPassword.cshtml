@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <h3 class="auth-title">Quên mật khẩu?</h3>
            <p class="auth-subtitle">Nhập email đã đăng ký, chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu</p>
            <hr class="auth-hr" />

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-label">Email</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="Nhập email đã đăng ký" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn">
                    Gửi hướng dẫn
                </button>
            </form>

            <p class="auth-switch">
                Đã nhớ mật khẩu?
                <a asp-page="./Login">Đăng nhập</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
