@page
@model VerifyOtpModel
@{
    ViewData["Title"] = "Xác thực email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card text-center">
            <div class="mb-3">
                <i class="bi bi-envelope-check" style="font-size:2.6rem; color:#495057;"></i>
            </div>
            <h3 class="auth-title">Xác thực email</h3>
            <p class="auth-subtitle">
                Chúng tôi đã gửi mã OTP gồm 6 chữ số tới <strong>@Model.Email</strong>.
                Mã có hiệu lực trong 5 phút.
            </p>
            <hr class="auth-hr" />

            @if (!string.IsNullOrEmpty(Model.OtpInfo))
            {
                <div class="alert alert-success py-2 small" role="alert">@Model.OtpInfo</div>
            }
            @if (!string.IsNullOrEmpty(Model.OtpError))
            {
                <div class="alert alert-danger py-2 small" role="alert">@Model.OtpError</div>
            }

            <form method="post" novalidate class="text-start">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="auth-field">
                    <label asp-for="Code" class="auth-label">Mã OTP</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Code"
                               class="auth-input"
                               inputmode="numeric"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="Nhập 6 chữ số"
                               style="letter-spacing:.3em; font-weight:600;" />
                    </div>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn">Xác thực</button>
            </form>

            <form method="post" asp-page-handler="Resend"
                  asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl" class="mt-3">
                <button type="submit" class="btn btn-link small p-0">Gửi lại mã OTP</button>
            </form>

            <p class="auth-switch">
                <a asp-page="./Login">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}