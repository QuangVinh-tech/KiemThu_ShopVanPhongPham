@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <h3 class="auth-title">Đăng ký tài khoản</h3>
            
            <hr class="auth-hr" />

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.FullName" class="auth-label">Họ và tên</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-person"></i></span>
                        <input asp-for="Input.FullName"
                               class="auth-input"
                               autocomplete="name"
                               aria-required="true"
                               placeholder="Nhập họ và tên" />
                    </div>
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-label">Email</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="Nhập email" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.PhoneNumber" class="auth-label">Số điện thoại</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-telephone"></i></span>
                        <input asp-for="Input.PhoneNumber"
                               class="auth-input"
                               autocomplete="tel"
                               aria-required="true"
                               placeholder="Nhập số điện thoại" />
                    </div>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="auth-label">Mật khẩu</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập mật khẩu" />
                        <button type="button" class="auth-eye" data-toggle-target="Input_Password" aria-label="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.ConfirmPassword" class="auth-label">Xác nhận mật khẩu</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.ConfirmPassword"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập lại mật khẩu" />
                        <button type="button" class="auth-eye" data-toggle-target="Input_ConfirmPassword" aria-label="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                    <label class="form-check-label auth-terms" for="agreeTerms">
                        Tôi đồng ý với <a href="#">Điều khoản sử dụng</a> và <a href="#">Chính sách bảo mật</a>
                    </label>
                </div>

                <button id="registerSubmit" type="submit" class="auth-btn">
                    Đăng ký
                </button>
            </form>

            <p class="auth-switch">
                Đã có tài khoản?
                <a asp-page="./Login">Đăng nhập ngay</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.auth-eye').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-toggle-target');
                var input = document.getElementById(id);
                var icon = btn.querySelector('i');
                if (!input) return;
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}
