@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card text-center">
            <div class="mb-3">
                <i class="bi bi-check-circle" style="font-size:2.6rem; color:#495057;"></i>
            </div>
            <h3 class="auth-title">Đặt lại mật khẩu thành công</h3>
            <p class="auth-subtitle">
                Mật khẩu của bạn đã được cập nhật. Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.
            </p>
            <a asp-page="./Login" class="auth-btn d-inline-block text-decoration-none">
                Đăng nhập ngay
            </a>
        </div>
    </div>
</section>
