@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Kiểm tra email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card text-center">
            <div class="mb-3">
                <i class="bi bi-envelope-check" style="font-size:2.6rem; color:#495057;"></i>
            </div>
            <h3 class="auth-title">Kiểm tra email của bạn</h3>
            <p class="auth-subtitle">
                Nếu email bạn nhập tồn tại trong hệ thống, chúng tôi đã gửi một liên kết
                đặt lại mật khẩu tới email đó. Vui lòng kiểm tra hộp thư (kể cả mục spam).
            </p>

            @if (!string.IsNullOrEmpty(Model.Link))
            {
                <hr class="auth-hr" />
                <p class="small text-muted mb-2">
                    Hệ thống demo chưa cấu hình gửi email thật, bạn có thể dùng liên kết dưới đây để đặt lại mật khẩu:
                </p>
                <a href="@Model.Link" class="d-inline-block text-break small">@Model.Link</a>
            }

            <p class="auth-switch">
                <a asp-page="./Login">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</section>
