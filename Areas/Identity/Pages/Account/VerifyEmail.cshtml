@page
@model VerifyEmailModel
@{
    ViewData["Title"] = "Xác minh email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="text-center mb-2">
                <i class="bi bi-envelope-check" style="font-size:2.6rem; color:#495057;"></i>
            </div>
            <h3 class="auth-title">Xác minh email</h3>
            <p class="auth-subtitle mb-2">Nhập mã gồm 6 số đã được gửi tới</p>
            <div class="text-center mb-3"><span class="auth-email-pill">@Model.Email</span></div>
            <hr class="auth-hr" />

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success py-2 small" role="alert">@Model.StatusMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" name="Email" value="@Model.Email" />
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="auth-field">
                    <label asp-for="Code" class="auth-label">Mã xác minh</label>
                    <div class="auth-input-group">
                        <input asp-for="Code"
                               class="auth-input otp-input"
                               inputmode="numeric"
                               maxlength="6"
                               autocomplete="one-time-code"
                               autofocus
                               placeholder="------" />
                    </div>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn">Xác minh</button>
            </form>

            <form method="post" asp-page-handler="Resend" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl" class="auth-switch">
                Chưa nhận được mã?
                <button type="submit" class="auth-link-btn">Gửi lại mã</button>
            </form>

            <p class="auth-switch mt-2">
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Chỉ cho nhập số
        document.getElementById('Code').addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 6);
        });
    </script>
}