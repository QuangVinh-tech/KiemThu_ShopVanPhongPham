@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <h3 class="auth-title">Đặt lại mật khẩu</h3>
            <p class="auth-subtitle mb-2">Nhập mã 6 số đã gửi tới email và mật khẩu mới</p>
            <div class="text-center mb-3"><span class="auth-email-pill">@Model.Input.Email</span></div>
            <hr class="auth-hr" />

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success py-2 small" role="alert">@Model.StatusMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 small" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                <input asp-for="Input.Email" type="hidden" />

                <div class="auth-field">
                    <label asp-for="Input.Code" class="auth-label">Mã xác nhận</label>
                    <div class="auth-input-group">
                        <input asp-for="Input.Code"
                               class="auth-input otp-input"
                               inputmode="numeric"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="------" />
                    </div>
                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="auth-label">Mật khẩu mới</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập mật khẩu mới" />
                        <button type="button" class="auth-eye" data-toggle-target="Input_Password" aria-label="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.ConfirmPassword" class="auth-label">Xác nhận mật khẩu mới</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.ConfirmPassword"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập lại mật khẩu mới" />
                        <button type="button" class="auth-eye" data-toggle-target="Input_ConfirmPassword" aria-label="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn">
                    Đặt lại mật khẩu
                </button>
            </form>

            <form method="post" asp-page-handler="Resend" asp-route-email="@Model.Input.Email" class="auth-switch">
                Chưa nhận được mã?
                <button type="submit" class="auth-link-btn">Gửi lại mã</button>
            </form>

            <p class="auth-switch mt-2">
                <a asp-page="./Login">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('Input_Code').addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 6);
        });

        document.querySelectorAll('.auth-eye').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-toggle-target');
                var input = document.getElementById(id);
                var icon = btn.querySelector('i');
                if (!input) return;
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}