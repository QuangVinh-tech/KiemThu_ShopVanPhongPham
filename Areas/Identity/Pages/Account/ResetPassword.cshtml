@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <h3 class="auth-title">Đặt lại mật khẩu</h3>
            <p class="auth-subtitle">Nhập mã OTP gồm 6 chữ số đã gửi tới email của bạn và mật khẩu mới (mã có hiệu lực 5 phút)</p>
            <hr class="auth-hr" />

            @if (!string.IsNullOrEmpty(Model.OtpInfo))
            {
                <div class="alert alert-success py-2 small" role="alert">@Model.OtpInfo</div>
            }
            @if (!string.IsNullOrEmpty(Model.OtpError))
            {
                <div class="alert alert-danger py-2 small" role="alert">@Model.OtpError</div>
            }

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-label">Email</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email" class="auth-input" readonly />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Code" class="auth-label">Mã OTP</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Input.Code"
                               class="auth-input"
                               inputmode="numeric"
                               maxlength="6"
                               autocomplete="one-time-code"
                               placeholder="Nhập 6 chữ số"
                               style="letter-spacing:.3em; font-weight:600;" />
                    </div>
                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="auth-label">Mật khẩu mới</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập mật khẩu mới" />
                        <button type="button" class="auth-eye" data-toggle-target="Input_Password" aria-label="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.ConfirmPassword" class="auth-label">Xác nhận mật khẩu mới</label>
                    <div class="auth-input-group">
                        <span class="auth-input-icon"><i class="bi bi-lock"></i></span>
                        <input asp-for="Input.ConfirmPassword"
                               class="auth-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập lại mật khẩu mới" />
                        <button type="button" class="auth-eye" data-toggle-target="Input_ConfirmPassword" aria-label="Hiện/ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="auth-btn">
                    Đặt lại mật khẩu
                </button>
            </form>

            <form method="post" asp-page-handler="Resend" asp-route-email="@Model.Input?.Email" class="mt-3 text-center">
                <button type="submit" class="btn btn-link small p-0">Gửi lại mã OTP</button>
            </form>

            <p class="auth-switch">
                <a asp-page="./Login">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.auth-eye').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.getAttribute('data-toggle-target');
                var input = document.getElementById(id);
                var icon = btn.querySelector('i');
                if (!input) return;
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}