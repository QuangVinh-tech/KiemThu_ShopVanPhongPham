@model List<ShopVanPhongPham.Models.WishlistItem>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<section class="py-5">
    <div class="container">

        <nav class="wf-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a> <span>&rsaquo;</span>
            <span class="active">Yêu thích</span>
        </nav>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <h2 class="fw-bold mb-4">
            <i class="bi bi-heart-fill text-danger me-2"></i>Sản phẩm yêu thích
            <span class="text-muted fs-6">(@Model.Count sản phẩm)</span>
        </h2>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-heart" style="font-size:3rem;color:#c3c6cc;"></i>
                <h4 class="text-muted mt-3">Bạn chưa có sản phẩm yêu thích nào</h4>
                <a asp-controller="Product" asp-action="Shop" class="btn btn-wf-dark mt-3">
                    <i class="bi bi-shop me-1"></i>Khám phá sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    var p = item.Product!;
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="wf-product-card position-relative">
                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="wf-product-thumb">
                                <img src="@p.ImageUrl" alt="@p.Name" onerror="this.src='/assets/images/placeholder.jpg'" />
                            </a>
                            <form asp-controller="Wishlist" asp-action="Remove" method="post" class="position-absolute top-0 end-0 m-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm" title="Bỏ yêu thích">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                            <div class="wf-product-body p-2">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="wf-product-name">
                                    @p.Name
                                </a>
                                <div class="wf-product-price fw-bold">@p.Price.ToString("N0") đ</div>
                                <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-wf-dark btn-sm w-100">
                                        <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
