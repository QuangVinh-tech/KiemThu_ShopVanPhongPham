@using Microsoft.AspNetCore.Identity
@using ShopVanPhongPham.Models.Interfaces
@inject IWishlistRepository WishlistRepo
@inject UserManager<IdentityUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop Văn Phòng Phẩm</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wireframe.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="site-header">
        <!-- Top utility bar -->
        <div class="topbar">
            <div class="container topbar-inner">
                <span><i class="bi bi-truck"></i> Giao hàng toàn quốc</span>
                <div class="topbar-right">
                    <span><i class="bi bi-telephone"></i> Hotline: 1900 1234</span>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-question-circle"></i> Hỗ trợ
                    </a>
                </div>
            </div>
        </div>

        <!-- Logo + tìm kiếm + tài khoản -->
        <div class="header-main">
            <div class="container header-main-inner">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-pencil-square"></i></span>
                    <span class="brand-text">
                        <strong>VanPhamPro</strong>

                    </span>
                </a>

                <form class="header-search" asp-controller="Product" asp-action="Shop" method="get">
                    <input name="search" type="text" placeholder="Tìm kiếm sản phẩm..." />
                    <button type="submit"><i class="bi bi-search"></i></button>
                </form>

                <ul class="header-actions navbar-nav flex-row">

                    @await Html.PartialAsync("_LoginPartial")

                    @{
                        var wishlistCount = User.Identity!.IsAuthenticated
                        ? WishlistRepo.GetWishlistCount(UserManager.GetUserId(User)!)
                        : 0;
                    }
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Wishlist" asp-action="Index"
                           class="header-action-item nav-link">
                            <i class="bi bi-heart"></i>
                            <span>Yêu thích</span>
                            @if (wishlistCount > 0)
                            {
                                <span class="action-badge">
                                    @wishlistCount
                                    <span class="visually-hidden">sản phẩm</span>
                                </span>
                            }
                        </a>
                    </li>

                    @{
                        var cartCount = Context.Session.GetInt32("CartCount") ?? 0;
                    }
                    <li class="nav-item">
                        <a asp-area="" asp-controller="ShoppingCart" asp-action="Index"
                           class="header-action-item nav-link">
                            <i class="bi bi-cart3"></i>
                            <span>Giỏ hàng</span>
                            @if (cartCount > 0)
                            {
                                <span class="action-badge">
                                    @cartCount
                                    <span class="visually-hidden">sản phẩm</span>
                                </span>
                            }
                        </a>
                    </li>

                </ul>
            </div>
        </div>

        <!-- Danh mục + menu chính -->
        <nav class="category-nav">
            <div class="container category-nav-inner">
                <button class="category-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#categoryOffcanvas">
                    <i class="bi bi-list"></i> Danh mục sản phẩm
                </button>

                <ul class="main-nav">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-area="" asp-controller="Product" asp-action="Shop">Sản phẩm</a></li>
                    <li><a asp-area="" asp-controller="Promotion" asp-action="Index">Khuyến mãi</a></li>
                    <li><a href="#">Tin tức</a></li>
                    <li><a href="#">Giới thiệu</a></li>
                    <li><a asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Offcanvas danh mục (mở từ nút "Danh mục sản phẩm") -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="categoryOffcanvas">
        <div class="offcanvas-header border-bottom">
            <h6 class="offcanvas-title fw-bold">Danh mục sản phẩm</h6>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="sidebar-cat-list p-3">
                @{
                    var navCategories = ViewBag.NavCategories as List<string>;
                }
                @if (navCategories != null && navCategories.Any())
                {
                    foreach (var cat in navCategories)
                    {
                        <li><a asp-controller="Product" asp-action="Shop" asp-route-category="@cat">@cat</a></li>
                    }
                }
                else
                {
                    <li><a asp-controller="Product" asp-action="Shop">Tất cả sản phẩm</a></li>
                }
            </ul>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-pencil-square me-1"></i>VanPhamPro
                    </h5>
                    <p class="text-secondary small">
                        Cung cấp văn phòng phẩm chất lượng cao,<br />
                        giá cạnh tranh, giao hàng nhanh toàn quốc.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase text-secondary fw-bold mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1">
                            <a asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-chevron-right me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="mb-1">
                            <a asp-area="" asp-controller="Product" asp-action="Shop">
                                <i class="bi bi-chevron-right me-1"></i>Cửa hàng
                            </a>
                        </li>
                        <li class="mb-1">
                            <a asp-area="" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-chevron-right me-1"></i>Liên hệ
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-uppercase text-secondary fw-bold mb-3">Liên hệ</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-2">
                            <i class="bi bi-geo-alt-fill me-2"></i>123 Nguyễn Văn A, Q.1, TP.HCM
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone-fill me-2"></i>0901 234 567
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope-fill me-2"></i>lienhe@shopvpp.vn
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <p class="text-center text-secondary small mb-0">
                &copy; 2026 VanPhamPro &mdash; Thiết kế bởi Nhóm MVC
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('.btn-add-cart');
            if (!btn) return;

            const productId = btn.dataset.productId;
            const fd = new FormData();
            fd.append('productId', productId);
            fd.append('quantity', '1');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) fd.append('__RequestVerificationToken', token);

            btn.disabled = true;
            try {
                const res = await fetch('/ShoppingCart/AddToCart', { method: 'POST', body: fd });
                const data = await res.json();

                const cartLink = document.querySelector('a[href*="ShoppingCart"]');
                let badge = cartLink?.querySelector('.action-badge');
                if (data.cartCount > 0) {
                    if (badge) {
                        badge.textContent = data.cartCount;
                    } else {
                        cartLink?.insertAdjacentHTML('beforeend',
                            `<span class="action-badge">${data.cartCount}</span>`);
                    }
                }

                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                setTimeout(() => {
                    btn.innerHTML = '<i class="bi bi-cart-plus"></i>';
                    btn.disabled = false;
                }, 1000);
            } catch {
                btn.disabled = false;
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>