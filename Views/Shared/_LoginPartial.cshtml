@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection

@{
    var signInManager = Context.RequestServices.GetService<SignInManager<IdentityUser>>();
    var userManager = Context.RequestServices.GetService<UserManager<IdentityUser>>();
    var isIdentityReady = signInManager != null && userManager != null;
}

@if (!isIdentityReady)
{
}
else if (signInManager!.IsSignedIn(User))
{
    var isAdmin = User.IsInRole("Admin"); // ← kiểm tra role Admin

    <li class="nav-item dropdown">
        <a class="header-action-item nav-link dropdown-toggle" href="#"
           id="userDropdown" role="button"
           data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle"></i>
            <span>@userManager!.GetUserName(User)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">

            @if (isAdmin)
            {
                <li>
                    <a class="dropdown-item text-warning fw-bold"
                       asp-area="Admin" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-shield-lock me-2"></i>Quản trị Admin
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
            }

            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-gear me-2"></i>Tài khoản
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders" asp-area="">
                    <i class="bi bi-bag me-2"></i>Lịch sử đơn hàng
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index","Home")"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="header-action-item nav-link" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-person"></i>
            <span>Đăng nhập</span>
        </a>
    </li>
}