@using ShopVanPhongPham.Models
@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

@{
    // Trả về class màu badge phù hợp với từng trạng thái đơn hàng
    string StatusBadgeClass(string? status) => (status ?? "Chờ xử lý") switch
    {
        "Chờ xử lý" => "bg-warning text-dark",
        "Đang giao" => "bg-info text-dark",
        "Đã giao" => "bg-success",
        "Đã hủy" => "bg-secondary",
        _ => "bg-warning text-dark"
    };
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">📦 Đơn hàng của tôi</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:3rem">🛒</div>
            <h5 class="text-muted mt-3">Bạn chưa có đơn hàng nào</h5>
            <a asp-controller="Product" asp-action="Shop"
               class="btn btn-primary mt-3">
                🛍️ Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Người nhận</th>
                        <th>Địa chỉ</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var status = order.Status ?? "Chờ xử lý";
                        var canCancel = status == "Chờ xử lý";
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td>@order.OrderPlaced.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.FirstName @order.LastName</td>
                            <td>@order.Address</td>
                            <td class="text-end fw-bold text-danger">
                                @order.OrderTotal.ToString("N0") ₫
                            </td>
                            <td class="text-center">
                                <span class="badge @StatusBadgeClass(order.Status)">
                                    @status
                                </span>
                            </td>
                            <td class="text-center">
                                @if (canCancel)
                                {
                                    <form asp-action="Cancel" asp-controller="Orders" method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng #@order.Id không?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            ✕ Hủy đơn
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Product" asp-action="Shop"
       class="btn btn-outline-primary mt-3">
        ← Tiếp tục mua sắm
    </a>
</div>