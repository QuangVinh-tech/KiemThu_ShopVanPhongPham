@{
    ViewData["Title"] = "Liên Hệ";
}

<section class="py-4">
    <div class="container">

        <nav class="wf-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a> <span>&rsaquo;</span>
            <span class="active">Liên hệ</span>
        </nav>

        <div class="contact-hero">
            <h1>Liên Hệ Với Chúng Tôi</h1>
            <p>Có câu hỏi về sản phẩm, đơn hàng hay hợp tác? Điền thông tin bên dưới hoặc liên hệ trực tiếp qua hotline, chúng tôi sẽ phản hồi trong thời gian sớm nhất.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Form liên hệ -->
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h5><i class="bi bi-envelope-paper me-2"></i>Gửi tin nhắn cho chúng tôi</h5>

                    <form asp-controller="Home" asp-action="Contact" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="fullName" class="form-control" placeholder="Nhập họ và tên của bạn" required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control" placeholder="example@email.com" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="tel" name="phone" class="form-control" placeholder="0901 234 567" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Chủ đề</label>
                                <select name="subject" class="form-select">
                                    <option value="">-- Chọn chủ đề --</option>
                                    <option value="Tư vấn sản phẩm">Tư vấn sản phẩm</option>
                                    <option value="Đặt hàng số lượng lớn">Đặt hàng số lượng lớn</option>
                                    <option value="Khiếu nại / Góp ý">Khiếu nại / Góp ý</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nội dung tin nhắn <span class="text-danger">*</span></label>
                            <textarea name="message" class="form-control" rows="5"
                                      placeholder="Nhập nội dung bạn muốn liên hệ..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-wf-dark btn-lg px-4">
                            <i class="bi bi-send me-1"></i> Gửi tin nhắn
                        </button>
                    </form>
                </div>
            </div>

            <!-- Thông tin liên hệ -->
            <div class="col-lg-5">
                <div class="sidebar-card">
                    <h6>Thông tin liên hệ</h6>
                    <div class="contact-info-list">
                        <div class="contact-info-item">
                            <span class="contact-info-icon"><i class="bi bi-geo-alt"></i></span>
                            <div>
                                <strong>Địa chỉ cửa hàng</strong>
                                <span>123 Nguyễn Văn A, Phường Bến Nghé, Q.1, TP.HCM</span>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <span class="contact-info-icon"><i class="bi bi-telephone"></i></span>
                            <div>
                                <strong>Hotline</strong>
                                <a href="tel:19001234">1900 1234</a> &middot; <a href="tel:0901234567">0901 234 567</a>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <span class="contact-info-icon"><i class="bi bi-envelope"></i></span>
                            <div>
                                <strong>Email</strong>
                                <a href="mailto:lienhe@shopvpp.vn">lienhe@shopvpp.vn</a>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <span class="contact-info-icon"><i class="bi bi-clock"></i></span>
                            <div>
                                <strong>Giờ làm việc</strong>
                                <span>Thứ 2 - Thứ 7: 8:00 - 21:00<br />Chủ nhật: 8:00 - 17:00</span>
                            </div>
                        </div>
                    </div>

                    <div class="contact-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Zalo"><i class="bi bi-chat-dots"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="Youtube"><i class="bi bi-youtube"></i></a>
                    </div>

                    <div class="contact-map">
                        <iframe src="https://www.google.com/maps?q=Qu%E1%BA%ADn%201%2C%20TP.HCM&output=embed"
                                loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                                title="Bản đồ cửa hàng VanPhamPro"></iframe>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
