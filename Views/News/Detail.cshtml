@model ShopVanPhongPham.Models.News
@{
    ViewData["Title"] = Model.Title;
}
<section class="py-5">
    <div class="container" style="max-width:800px">
        <nav class="mb-3">
            <a asp-controller="News" asp-action="Index">← Quay lại Tin tức</a>
        </nav>
        <h1 class="fw-bold mb-2">@Model.Title</h1>
        <p class="text-muted mb-4">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        <div style="white-space:pre-line">@Model.Content</div>
    </div>
</section>