@model IEnumerable<ShopVanPhongPham.Models.News>
@{
    ViewData["Title"] = "Tin tức";
}
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">Tin tức</h2>
        <div class="row g-4">
            @foreach (var news in Model)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <a asp-controller="News" asp-action="Detail" asp-route-id="@news.Id"
                                   class="text-decoration-none text-dark">@news.Title</a>
                            </h5>
                            <p class="text-muted small mb-2">@news.CreatedAt.ToString("dd/MM/yyyy")</p>
                            <p class="card-text">
                                @(news.Content.Length > 150 ? news.Content.Substring(0, 150) + "..." : news.Content)
                            </p>
                            <a asp-controller="News" asp-action="Detail" asp-route-id="@news.Id"
                               class="btn btn-outline-dark btn-sm">Đọc tiếp</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-5">Chưa có tin tức nào.</p>
        }
    </div>
</section>